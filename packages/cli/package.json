{
  "name": "@pov/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pov": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pov": "node --import tsx src/index.ts",
    "register-schema": "node --import tsx src/register-schema.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
